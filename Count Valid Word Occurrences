class Solution {
public:
    vector<int> countWordOccurrences(vector<string>& chunks, vector<string>& queries) {
        string chunkString;
        for (int i=0; i<chunks.size(); i++) {
            for (int j=0; j<chunks[i].size(); j++) {
                chunkString.push_back(chunks[i][j]);
            }
        }
        string currWord;
        unordered_map<string,int> wordFreq;
        int n=chunkString.size();
        for (int i=0; i<n; i++) {
            if (chunkString[i]==' ') {
                if (currWord.size()>0 && currWord[currWord.size()-1]=='-') {
                    currWord.pop_back();
                }
                if (currWord.size()>0) {
                    wordFreq[currWord]++;
                    currWord="";
                }
            }
            else if (chunkString[i]=='-') {
                if (currWord.size()>0) {
                    if (currWord[currWord.size()-1]=='-') {
                        currWord.pop_back();
                        if (currWord.size()>0) {
                            wordFreq[currWord]++;
                        }
                        currWord="";
                    }
                    else currWord.push_back('-');
                }
            }
            else {
                currWord.push_back(chunkString[i]);
            }
        }
        if (currWord.size()>0) {
            if (currWord[currWord.size()-1]=='-') {
                currWord.pop_back();
            }
        }
        wordFreq[currWord]++;
        vector<int> ans;
        for (int i=0; i<queries.size(); i++) {
            ans.push_back(wordFreq[queries[i]]);
        }
        return ans;
    }
};
