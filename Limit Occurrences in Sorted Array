class Solution {
public:
    vector<int> limitOccurrences(vector<int>& nums, int k) {
        unordered_map<int,int> numsFreq;
        vector<int> ans;
        for (int i=0; i<nums.size(); i++) {
            if (numsFreq[nums[i]]<k) {
                numsFreq[nums[i]]++;
                ans.push_back(nums[i]);
            }
        }
        return ans;
    }
};
