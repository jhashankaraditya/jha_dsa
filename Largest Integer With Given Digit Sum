class Solution {
public:
    int largestInteger(int n, int s) {
        int low=0, high=0;
        if (n==1) {
            high=9;
        }
        else if (n==2) {
            high=99;
        }
        else if (n==3) {
            high=999;
        }
        else if (n==4) {
            high=9999;
        }
        else if (n==5) {
            high=99999;
        }
        int ans=-1;
        for (int i=high; i>=0; i--) {
            int num=i, sum=0;
            while (num>0) {
                int digit=(num%10);
                sum+=digit;
                num/=10;
            }
            if (sum==s) {
                ans=i;
                break;
            }
        }
        return ans;
    }
};
